# Local setup only (a Codespace uses a secret instead). Copy this file to .env, fill it in, and load it
# in every new terminal with:
#   set -a; source .env; set +a
# Never commit .env: it holds your token, and your key if you add one.

# The agent under test runs on GitHub Copilot. Recommended: a fine-grained personal access token
# (resource owner: your personal account; Account permissions: Copilot Requests).
COPILOT_GITHUB_TOKEN=

# Alternative to the token: sign in with `copilot login`, then uncomment this line. Vally then runs
# with your Copilot home (~/.copilot), including your own skills, plugins and settings.
# EVALUATE_USE_HOST_COPILOT_HOME=1

# Optional: your own model endpoint, for the LLM judge in Lab 5 and the agent in Lab 8, part B.
# Leave these empty, and the judge runs on your Copilot plan. See "Model access and costs" on the site.
# The endpoint's base URL, for example https://<your-resource>.openai.azure.com/openai/v1/
LLM_BASE_URL=
# Its API key
LLM_API_KEY=
# The model's deployment name on that endpoint
LLM_MODEL=
