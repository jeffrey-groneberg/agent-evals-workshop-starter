# Local setup only: in a Codespace, you don't need this file. Copy it to .env, then load it in every new
# terminal with:
#   set -a; source .env; set +a
# Never commit .env: Git ignores it, because it can hold a token or a key.

# The agent under test and the LLM judge run on GitHub Copilot. The next line signs Vally and Copilot CLI
# in with your GitHub CLI sign-in: run `gh auth login` once and leave the line as it is. It reads the token
# each time you load this file, so the token itself is never written here.
COPILOT_GITHUB_TOKEN=$(gh auth token)
# If Lab 0 can't sign in that way, replace the line above with a fine-grained personal access token
# (resource owner: your personal account; Account permissions: Copilot Requests):
# COPILOT_GITHUB_TOKEN=github_pat_...

# Another alternative: sign in with `copilot login`, comment out the COPILOT_GITHUB_TOKEN line, and
# uncomment the next line. Vally then runs with your Copilot home (~/.copilot), including your own
# skills, plugins and settings.
# EVALUATE_USE_HOST_COPILOT_HOME=1

# Optional: your own model endpoint, for the LLM judge in Lab 5 and the agent in Lab 8, part B.
# Leave these empty, and the judge runs on your Copilot plan. See "Model access and costs" on the site.
# The endpoint's base URL, for example https://<your-resource>.openai.azure.com/openai/v1/
LLM_BASE_URL=
# Its API key
LLM_API_KEY=
# The model's deployment name on that endpoint
LLM_MODEL=
